<?php
/**
 * Base Controller
 * 
 * Provides common functionality for all controllers
 * Extend this class for all your controllers
 * 
 * @package FCT_CNS
 */

class Controller {
    /**
     * @var array Data to pass to views
     */
    protected $data = [];
    
    /**
     * @var string Layout template
     */
    protected $layout = 'main';
    
    /**
     * @var string View name
     */
    protected $view;
    
    /**
     * Constructor
     */
    public function __construct() {
        // Initialize any common controller logic here
    }
    
    /**
     * Render a view with layout
     * 
     * @param string $view View name (without .php extension)
     * @param array $data Data to pass to the view
     */
    protected function render($view = null, $data = []) {
        // Use provided view or default to controller action name
        $this->view = $view ?? $this->getDefaultViewName();
        
        // Merge with controller data
        $this->data = array_merge($this->data, $data);
        
        // Extract data for view
        extract($this->data);
        
        // Start output buffering
        ob_start();
        
        // Include the view file
        $viewPath = APP_PATH . '/views/pages/' . $this->view . '.php';
        if (!file_exists($viewPath)) {
            throw new Exception("View not found: " . $viewPath);
        }
        include $viewPath;
        
        // Get view content
        $content = ob_get_clean();
        
        // Include layout if specified
        if ($this->layout) {
            $layoutPath = APP_PATH . '/views/layouts/' . $this->layout . '.php';
            if (file_exists($layoutPath)) {
                // $content variable is available in layout
                include $layoutPath;
            } else {
                // No layout, just output content
                echo $content;
            }
        } else {
            echo $content;
        }
    }
    
    /**
     * Get default view name based on called method
     * 
     * @return string View name
     */
    protected function getDefaultViewName() {
        // Get called class and method
        $trace = debug_backtrace(DEBUG_BACKTRACE_IGNORE_ARGS, 3);
        $method = $trace[2]['function'];
        
        // Convert camelCase to kebab-case
        $viewName = strtolower(preg_replace('/(?<!^)[A-Z]/', '-$0', $method));
        
        return $viewName;
    }
    
    /**
     * Render JSON response
     * 
     * @param mixed $data Data to encode as JSON
     * @param int $statusCode HTTP status code
     */
    protected function json($data, $statusCode = 200) {
        http_response_code($statusCode);
        header('Content-Type: application/json');
        echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
        exit;
    }
    
    /**
     * Redirect to URL
     * 
     * @param string $url URL to redirect to
     * @param int $statusCode HTTP status code
     */
    protected function redirect($url, $statusCode = 302) {
        if (strpos($url, 'http') !== 0) {
            $url = BASE_URL . '/' . ltrim($url, '/');
        }
        header("Location: $url", true, $statusCode);
        exit;
    }
    
    /**
     * Set a flash message
     * 
     * @param string $key Message key
     * @param string $message Message content
     */
    protected function flash($key, $message) {
        if (!isset($_SESSION['flash'])) {
            $_SESSION['flash'] = [];
        }
        $_SESSION['flash'][$key] = $message;
    }
    
    /**
     * Get a flash message
     * 
     * @param string $key Message key
     * @return string|null Message content or null
     */
    protected function getFlash($key) {
        if (isset($_SESSION['flash'][$key])) {
            $message = $_SESSION['flash'][$key];
            unset($_SESSION['flash'][$key]);
            return $message;
        }
        return null;
    }
    
    /**
     * Get POST data
     * 
     * @param string $key Optional key
     * @param mixed $default Default value if key not found
     * @return mixed
     */
    protected function input($key = null, $default = null) {
        if ($key === null) {
            return $_POST;
        }
        return $_POST[$key] ?? $default;
    }
    
    /**
     * Get GET data
     * 
     * @param string $key Optional key
     * @param mixed $default Default value if key not found
     * @return mixed
     */
    protected function query($key = null, $default = null) {
        if ($key === null) {
            return $_GET;
        }
        return $_GET[$key] ?? $default;
    }
    
    /**
     * Validate CSRF token
     */
    protected function validateCsrf() {
        $token = $this->input('_csrf_token');
        if (empty($token) || !hash_equals($_SESSION['csrf_token'] ?? '', $token)) {
            throw new Exception('Invalid CSRF token');
        }
    }
    
    /**
     * Generate CSRF token
     */
    protected function csrfToken() {
        if (empty($_SESSION['csrf_token'])) {
            $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
        }
        return $_SESSION['csrf_token'];
    }
    
    /**
     * Check if request is AJAX
     */
    protected function isAjax() {
        return isset($_SERVER['HTTP_X_REQUESTED_WITH']) && 
               strtolower($_SERVER['HTTP_X_REQUESTED_WITH']) === 'xmlhttprequest';
    }
    
    /**
     * Set HTTP status code
     */
    protected function status($code) {
        http_response_code($code);
        return $this;
    }
    
    /**
     * Set response header
     */
    protected function header($name, $value) {
        header("$name: $value");
        return $this;
    }
}