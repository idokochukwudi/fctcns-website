                                    </div>
                                    <div class="article-meta">
                                        <span><i class="far fa-calendar"></i> 
                                            <?php 
                                            if (($item['type'] ?? 'news') === 'event' && !empty($item['event_date'])) {
                                                echo date('M d, Y', strtotime($item['event_date']));
                                            } else {
                                                echo date('M d, Y', strtotime($item['created_at'] ?? 'now'));
