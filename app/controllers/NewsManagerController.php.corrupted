                    <div class="card-body">
                        <!-- Time-based Stats -->
                        <div class="quick-stats">
                            <div class="quick-stat-item">
                                <div class="quick-stat-value"><?php echo $stats['this_week'] ?? 0; ?></div>
                                <div class="quick-stat-label">This Week</div>
                            </div>
                            <div class="quick-stat-item">
                                <div class="quick-stat-value"><?php echo $stats['this_month'] ?? 0; ?></div>
                                <div class="quick-stat-label">This Month</div>
                            </div>
                        </div>

                        <!-- Breakdown by Status -->
                        <h4 style="margin: 1rem 0 0.5rem; font-size: 0.9rem; color: var(--text-light);">Content Breakdown</h4>
                        <div style="margin-bottom: 1.5rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span>News vs Events</span>
                                <span>
                                    <?php echo $stats['news'] ?? 0; ?> News / 
                                    <?php echo $stats['events'] ?? 0; ?> Events
                                </span>
                            </div>
                            <div style="display: flex; justify-content: space-between;">
                                <span>Published vs Drafts</span>
                                <span>
                                    <?php echo $stats['published'] ?? 0; ?> Published / 
                                    <?php echo $stats['draft'] ?? 0; ?> Drafts
                                </span>
                            </div>
                        </div>

                        <!-- Drafts List -->
                        <?php 
                        $drafts = array_filter($content, function($item) {
                            return !($item['is_published'] ?? 0);
                        });
                        if (!empty($drafts)): 
                        ?>
                        <h4 style="margin: 1rem 0 0.5rem; font-size: 0.9rem; color: var(--text-light);">
                            <i class="fas fa-pen-fancy" style="color: var(--warning);"></i> 
                            Drafts Need Attention
                        </h4>
                        <ul class="article-list">
                            <?php foreach (array_slice($drafts, 0, 3) as $draft): ?>
                            <li class="article-item">
                                <div class="article-info">
                                    <div class="article-title" style="font-size: 0.9rem;">
                                        <a href="<?php echo $baseUrl; ?>/admin/news-manager/<?php echo $draft['id']; ?>/edit">
                                            <?php echo htmlspecialchars(strlen($draft['title'] ?? '') > 30 ? 
                                                substr($draft['title'], 0, 30) . '...' : 
                                                ($draft['title'] ?? 'Untitled')); ?>
                                        </a>
                                    </div>
                                    <div class="article-meta">
                                        <span>Last edited <?php 
                                            $date = $draft['updated_at'] ?? $draft['created_at'] ?? 'now';
                                            echo date('M d', strtotime($date)); 
                                        ?></span>
                                    </div>
                                </div>
                                <a href="<?php echo $baseUrl; ?>/admin/news-manager/<?php echo $draft['id']; ?>/edit" class="btn btn-sm" style="background: var(--light); color: var(--text);">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </li>
                            <?php endforeach; ?>
                        </ul>
                        <?php endif; ?>

                        <!-- Upcoming Events -->
                        <?php 
                        $upcomingEvents = array_filter($content, function($item) {
                            return ($item['type'] ?? 'news') === 'event' && 
                                   !empty($item['event_date']) && 
                                   strtotime($item['event_date']) >= strtotime('today');
                        });
                        if (!empty($upcomingEvents)): 
                        ?>
                        <h4 style="margin: 1rem 0 0.5rem; font-size: 0.9rem; color: var(--text-light);">
                            <i class="fas fa-calendar-alt" style="color: var(--purple);"></i> 
                            Upcoming Events
                        </h4>
                        <ul class="article-list">
                            <?php foreach (array_slice($upcomingEvents, 0, 3) as $event): ?>
                            <li class="article-item">
                                <div class="article-info">
                                    <div class="article-title" style="font-size: 0.9rem;">
                                        <a href="<?php echo $baseUrl; ?>/admin/news-manager/<?php echo $event['id']; ?>/edit">
                                            <?php echo htmlspecialchars(strlen($event['title'] ?? '') > 30 ? 
                                                substr($event['title'], 0, 30) . '...' : 
                                                ($event['title'] ?? 'Untitled')); ?>
                                        </a>
                                    </div>
                                    <div class="article-meta">
                                        <span><i class="far fa-calendar"></i> 
                                            <?php echo date('M d, Y', strtotime($event['event_date'])); ?>
                                        </span>
                                        <?php if (!empty($event['event_location'])): ?>
                                        <span><i class="fas fa-map-marker-alt"></i> 
                                            <?php echo htmlspecialchars($event['event_location']); ?>
                                        </span>
                                        <?php endif; ?>
                                    </div>
                                </div>
                            </li>
                            <?php endforeach; ?>
                        </ul>
                        <?php endif; ?>
                    </div>
                </div>
            </div>

            <!-- Categories Section -->
            <?php if (!empty($categories)): ?>
            <div class="card" style="margin-top: 1.5rem;">
                <div class="card-header">
                    <h3><i class="fas fa-tags"></i> Categories</h3>
                    <?php if ($hasPermission('news_manage_categories')): ?>
                    <a href="<?php echo $baseUrl; ?>/admin/news-manager/categories">Manage</a>
                    <?php endif; ?>
                </div>
                <div class="card-body">
                    <div class="category-tags">
                        <?php foreach ($categories as $category): 
                            $catName = is_array($category) ? ($category['name'] ?? 'Category') : $category;
                            $catCount = is_array($category) ? ($category['count'] ?? 0) : 0;
                        ?>
                        <a href="<?php echo $baseUrl; ?>/admin/news-manager?category=<?php echo urlencode($catName); ?>" class="category-tag">
                            <?php echo htmlspecialchars($catName); ?>
                            <?php if ($catCount > 0): ?>
                            <span class="category-count">(<?php echo $catCount; ?>)</span>
                            <?php endif; ?>
                        </a>
                        <?php endforeach; ?>
                    </div>
                </div>
            </div>
            <?php endif; ?>
        </div>
    </main>

    <script>
        // Mobile menu toggle
        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const sidebar = document.getElementById('sidebar');

        mobileMenuToggle.addEventListener('click', function() {
            sidebar.classList.toggle('active');
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(event) {
            if (window.innerWidth <= 768 && 
                !sidebar.contains(event.target) && 
                !mobileMenuToggle.contains(event.target) && 
                sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });

        // Auto-hide flash messages
        setTimeout(() => {
            document.querySelectorAll('.flash-message').forEach(msg => {
                msg.style.opacity = '0';
                msg.style.transition = 'opacity 0.5s';
                setTimeout(() => msg.remove(), 500);
            });
        }, 5000);

        // Notification button
        const notificationBtn = document.getElementById('notificationBtn');
        if (notificationBtn) {
            notificationBtn.addEventListener('click', function() {
                const drafts = <?php echo $stats['draft'] ?? 0; ?>;
                const breaking = <?php echo $stats['breaking'] ?? 0; ?>;
                
                let message = '📋 Notifications:\n\n';
                
                if (drafts > 0) {
                    message += `• You have ${drafts} draft article(s) waiting\n`;
                }
                if (breaking > 0) {
                    message += `• ${breaking} breaking news article(s) need attention\n`;
                }
                if (drafts === 0 && breaking === 0) {
                    message += 'No new notifications';
                }
                
                alert(message);
            });
        }

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            <?php if ($hasPermission('news_create')): ?>
            // Ctrl/Cmd + N for new news
            if ((e.ctrlKey || e.metaKey) && e.key === 'n') {
                e.preventDefault();
                window.location.href = '<?php echo $baseUrl; ?>/admin/news-manager/create?type=news';
            }
            // Ctrl/Cmd + Shift + N for new event
            if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key === 'N') {
                e.preventDefault();
                window.location.href = '<?php echo $baseUrl; ?>/admin/news-manager/create?type=event';
            }
            <?php endif; ?>

            // Ctrl/Cmd + D for dashboard
            if ((e.ctrlKey || e.metaKey) && e.key === 'd') {
                e.preventDefault();
                window.location.href = '<?php echo $baseUrl; ?>/admin/news-manager';
            }
        });
    </script>
</body>
</html>