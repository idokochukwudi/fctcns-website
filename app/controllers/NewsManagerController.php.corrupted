                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section">
                <h3 class="nav-section-title">Navigation</h3>
                <ul class="nav-links">
                    <li class="nav-item">
                        <a href="<?php echo $baseUrl; ?>/admin/dashboard" class="nav-link">
                            <i class="fas fa-arrow-left nav-icon"></i>
                            <span>Main Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="<?php echo $baseUrl; ?>" class="nav-link" target="_blank">
