<?php
/**
 * Global Helper Functions
 * Include this file early in your bootstrap
 * 
 * Location: app/helpers/functions.php
 */

// ============================================================================
// URL FUNCTIONS
// ============================================================================

if (!function_exists('url')) {
    /**
     * Generate a full URL
     * 
     * @param string $path The path to append to base URL
     * @return string Full URL
     */
    function url($path = '') {
        return BASE_URL . ($path ? '/' . ltrim($path, '/') : '');
    }
}

if (!function_exists('asset')) {
    /**
     * Generate an asset URL
     * 
     * @param string $asset Asset path relative to assets folder
     * @return string Full asset URL
     */
    function asset($asset) {
        return BASE_URL . '/assets/' . ltrim($asset, '/');
    }
}

if (!function_exists('upload')) {
    /**
     * Generate an upload URL
     * 
     * @param string $file Upload file path relative to uploads folder
     * @return string Full upload URL
     */
    function upload($file) {
        return BASE_URL . '/uploads/' . ltrim($file, '/');
    }
}

if (!function_exists('asset_path')) {
    /**
     * Alias for asset() function for backward compatibility
     * 
     * @param string $path Relative path starting with /assets/...
     * @return string Full URL to the asset
     */
    function asset_path($path) {
        return asset($path);
    }
}

if (!function_exists('carousel_image')) {
    /**
     * Get the full URL for a carousel image
     * 
     * @param string $imagePath Path from database (e.g., /assets/images/carousel/slide.jpg)
     * @return string Full URL to the image
     */
    function carousel_image($imagePath) {
        if (empty($imagePath)) {
            return asset('/assets/images/placeholder.jpg');
        }
        
        return asset($imagePath);
    }
}

// ============================================================================
// NAVIGATION FUNCTIONS
// ============================================================================

if (!function_exists('nav_link')) {
    /**
     * Generate a link tag with active class
     * 
     * @param string $url The URL
     * @param string $text Link text
     * @param string $activeClass Class to add if active
     * @return string HTML link
     */
    function nav_link($url, $text, $activeClass = 'active') {
        $currentUrl = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
        $basePath = '/fctcns-website';
        
        // Remove base path from current URL for comparison
        if (strpos($currentUrl, $basePath) === 0) {
            $currentUrl = substr($currentUrl, strlen($basePath));
        }
        
        $isActive = ($currentUrl === $url || $currentUrl === $url . '/');
        
        $class = $isActive ? 'class="' . $activeClass . '"' : '';
        return '<a href="' . url($url) . '" ' . $class . '>' . e($text) . '</a>';
    }
}

if (!function_exists('is_active')) {
    /**
     * Check if current page is active
     * 
     * @param string $url URL to check
     * @return bool True if active
     */
    function is_active($url) {
        $currentUrl = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
        $basePath = '/fctcns-website';
        
        // Remove base path from current URL for comparison
        if (strpos($currentUrl, $basePath) === 0) {
            $currentUrl = substr($currentUrl, strlen($basePath));
        }
        
        return ($currentUrl === $url || $currentUrl === $url . '/');
    }
}

// ============================================================================
// REDIRECTION FUNCTIONS
// ============================================================================

if (!function_exists('redirect')) {
    /**
     * Redirect to a URL
     * 
     * @param string $url URL to redirect to
     * @param int $statusCode HTTP status code
     */
    function redirect($url, $statusCode = 302) {
        header('Location: ' . url($url), true, $statusCode);
        exit;
    }
}

if (!function_exists('current_url')) {
    /**
     * Get current URL
     * 
     * @return string Current URL
     */
    function current_url() {
        $protocol = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
        return $protocol . '://' . $_SERVER['HTTP_HOST'] . $_SERVER['REQUEST_URI'];
    }
}

// ============================================================================
// FORM & SESSION FUNCTIONS
// ============================================================================

if (!function_exists('old')) {
    /**
     * Get old input value from session (for form repopulation)
     * 
     * @param string $key Form field name
     * @param mixed $default Default value if not found
     * @return mixed Old value or default
     */
    function old($key, $default = '') {
        return $_SESSION['form_data'][$key] ?? $default;
    }
}

if (!function_exists('flash')) {
    /**
     * Get flash message from session
     * 
     * @param string $key Flash message key
     * @param mixed $default Default value if not found
     * @return mixed Flash message or default
     */
    function flash($key, $default = '') {
        $value = $_SESSION[$key] ?? $default;
        if (isset($_SESSION[$key])) {
            unset($_SESSION[$key]);
        }
        return $value;
    }
}

// ============================================================================
// SECURITY FUNCTIONS
// ============================================================================

if (!function_exists('e')) {
    /**
     * Escape HTML entities (SECURITY: Prevents XSS attacks)
     * 
     * @param mixed $data String or array to escape
     * @return mixed Escaped data
     */
    function e($data) {
        if (is_array($data)) {
            return array_map('e', $data);
        }
        return htmlspecialchars($data ?? '', ENT_QUOTES, 'UTF-8');
    }
}

// ============================================================================
// DEBUGGING FUNCTIONS
// ============================================================================

if (!function_exists('dd')) {
    /**
     * Dump and die - for debugging
     * 
     * @param mixed ...$vars Variables to dump
     */
    function dd(...$vars) {
        echo '<pre style="background: #f5f5f5; padding: 20px; border: 1px solid #ddd; margin: 20px;">';
        foreach ($vars as $var) {
            var_dump($var);
        }
        echo '</pre>';
        die();
    }
}

if (!function_exists('dump')) {
    /**
     * Dump variable without dying - for debugging
     * 
     * @param mixed ...$vars Variables to dump
     */
    function dump(...$vars) {
        echo '<pre style="background: #f5f5f5; padding: 20px; border: 1px solid #ddd; margin: 20px;">';
        foreach ($vars as $var) {
            var_dump($var);
        }
        echo '</pre>';
    }
}

// ============================================================================
// PARAMETER FUNCTIONS
// ============================================================================

if (!function_exists('get_param')) {
    /**
     * Get query parameter
     * 
     * @param string $key Parameter key
     * @param mixed $default Default value
     * @return mixed Parameter value
     */
    function get_param($key, $default = null) {
        return $_GET[$key] ?? $default;
    }
}

if (!function_exists('post_param')) {
    /**
     * Get POST parameter
     * 
     * @param string $key Parameter key
     * @param mixed $default Default value
     * @return mixed Parameter value
     */
    function post_param($key, $default = null) {
        return $_POST[$key] ?? $default;
    }
}

// ============================================================================
// ROUTING FUNCTIONS (SIMPLE)
// ============================================================================

if (!function_exists('route')) {
    /**
     * Generate route URL (MVC-friendly)
     * 
     * @param string $controller Controller name
     * @param string $action Action method
     * @param array $params Route parameters
     * @return string Generated URL
     */
    function route($controller, $action = null, $params = []) {
        if ($action === null) {
            return url('/' . $controller);
        }
        
        $url = '/' . $controller . '/' . $action;
        
        // Add parameters if any
        if (!empty($params)) {
            $url .= '?' . http_build_query($params);
        }
        
        return url($url);
    }
}
?>