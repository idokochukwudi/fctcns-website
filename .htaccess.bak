# ============================================================================
# FCT College of Nursing Sciences - Root .htaccess
# Redirects all traffic to the public folder
# ============================================================================

RewriteEngine On

# If not already in public directory, redirect to public folder
RewriteCond %{REQUEST_URI} !^/fctcns-website/public/
RewriteRule ^(.*)$ public/$1 [L,QSA]

# Prevent directory listing
Options -Indexes

# Block access to sensitive directories
RedirectMatch 403 ^/(app|database|backups|logs|scripts)(/|$)
RedirectMatch 403 /\.(git|env|htaccess|htpasswd|gitignore)

# Block access to specific file types
<FilesMatch "\.(env|log|sql|bak|inc|config|md|lock|xml|json|yml|yaml|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>