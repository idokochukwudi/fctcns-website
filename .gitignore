# ============================================================================
# ENVIRONMENT FILES
# ============================================================================
# Environment files - NEVER commit these to repository
.env
.env.local
.env.development
.env.staging
.env.production
.env.*
!.env.example

# ============================================================================
# APPLICATION LOGS
# ============================================================================
logs/
*.log
*.error
npm-debug.log*
yarn-debug.log*
yarn-error.log*
storage/logs/
storage/*.log
!storage/.gitkeep

# ============================================================================
# RUNTIME DATA
# ============================================================================
storage/
storage/*.cache
storage/*.session
storage/*.lock
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/framework/testing/
*.sqlite
*.sqlite3
*.sqlite-journal
*.db

# ============================================================================
# DEPENDENCIES
# ============================================================================
# Composer
vendor/
composer.lock
composer.phar

# NPM / Node
node_modules/
npm-debug.log
package-lock.json
yarn.lock
yarn-error.log

# ============================================================================
