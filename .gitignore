public/assets/uploads/
public/uploads/
uploads/
!public/assets/uploads/.gitkeep
!public/uploads/.gitkeep
!uploads/.gitkeep

# ============================================================================
# TEMPORARY FILES
# ============================================================================
*.tmp
*.temp
*.cache
*.backup
*.bak
*.old
*.swp
*.swo
*~

# ============================================================================
# CACHE
