# ============================================================================
# FCT College of Nursing Sciences - Main .htaccess
# ============================================================================

# Enable rewrite engine
RewriteEngine On

# Set the base path for this subdirectory
RewriteBase /fctcns-website/

# If the request is for a file that doesn't exist in the root
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# And if the request doesn't already go to public folder
RewriteCond %{REQUEST_URI} !^/fctcns-website/public/

# Redirect everything to public folder
RewriteRule ^(.*)$ public/$1 [L,QSA]

# If accessing the project root, redirect to public
RewriteRule ^$ public/ [L]

# Security headers (simplified version)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|log|sql|bak|inc|config|htaccess)$">
    Require all denied
</FilesMatch>
