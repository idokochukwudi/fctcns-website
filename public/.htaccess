<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    
    # If the request is for a valid FILE, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [QSA,L]
    
    # If the request is for a valid DIRECTORY, serve it directly
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [QSA,L]
    
    # Otherwise, route everything through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security Headers (Properly set as HTTP headers)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Disable directory browsing
Options -Indexes

# PROTECT SENSITIVE FILES
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak|old)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>