# ============================================================================
# FCT College of Nursing Sciences - Main .htaccess
# Redirects ALL traffic to public/ folder for security
# ============================================================================

# Enable rewrite engine
RewriteEngine On

# Set the base directory for the project
RewriteBase /fctcns-website/

# Don't apply rules to the public folder itself
RewriteCond %{REQUEST_URI} !^/fctcns-website/public/

# Don't rewrite requests for existing files or directories in root
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect everything to the public folder
RewriteRule ^(.*)$ public/$1 [L]

# If accessing root, redirect to public
RewriteRule ^$ public/ [L]

# Security headers for root level
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"

# Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|log|sql|bak|inc|config|htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes
