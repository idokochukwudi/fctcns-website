# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_NAME="FCT College of Nursing Sciences"
APP_ENV=development
APP_KEY=base64:your-app-key-here

# ============================================================================
# PATH CONFIGURATION
# ============================================================================
ROOT_PATH=/path/to/your/project
PUBLIC_PATH=/path/to/your/project/public
BASE_URL=http://localhost

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fctcns_main
DB_USERNAME=your_username
DB_PASSWORD=your_password

# ============================================================================
# ADMIN CREDENTIALS
# ============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

# ============================================================================
# FILE UPLOADS
# ============================================================================
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOC_TYPES=pdf,doc,docx

# ============================================================================
# CAROUSEL SETTINGS
# ============================================================================
CAROUSEL_AUTO_ROTATE=true
CAROUSEL_INTERVAL=5000
CAROUSEL_TRANSITION=500

# ============================================================================
# REMITA PAYMENT CONFIGURATION (Demo Credentials)
# ============================================================================
# Get your live credentials from Remita when going live
REMITA_MERCHANT_ID=27768931
REMITA_API_KEY=Q1dHREVNTzEyMzR8Q1dHREVNTw==
REMITA_SERVICE_TYPE_ID=35126630
REMITA_PUBLIC_KEY=your_public_key_here
REMITA_SECRET_KEY=your_secret_key_here
REMITA_ENVIRONMENT=demo